<policies>
    <inbound>
        <base />
        <!-- 1. Validate the token properties WITHOUT verifying a signature -->
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Access Denied. Invalid or expired token.">
            <issuer-signing-keys>
                <key>WW91clN1cGVyTG9uZ0FuZFNlY3VyZVNlY3JldEtleVRoYXRJc0F0TGVhc3QyNTZCaXRzTG9uZyEh</key>
            </issuer-signing-keys>
            <audiences>
                <audience>db74cad0-c753-480f-a0fe-a31dbc1d17e6</audience>
            </audiences>
            <issuers>
                <issuer>https://azure-api.net</issuer>
            </issuers>
        </validate-jwt>
        <!-- 2. Safely extract the user data and role from the valid token -->
        <set-header name="X-User-Name" exists-action="override">
            <value>@(context.Request.Headers.GetValueOrDefault("Authorization","").Split(' ').Last().AsJwt()?.Claims.GetValueOrDefault("preferred_username", "anonymous"))</value>
        </set-header>
        <set-header name="X-User-Role" exists-action="override">
            <value>@(context.Request.Headers.GetValueOrDefault("Authorization","").Split(' ').Last().AsJwt()?.Claims.GetValueOrDefault("roles", "ROLE_CUSTOMER"))</value>
        </set-header>
        <set-header name="X-User-Id" exists-action="override">
            <value>@(context.Request.Headers.GetValueOrDefault("Authorization","").Split(' ').Last().AsJwt()?.Claims.GetValueOrDefault("userId", "0"))</value>
        </set-header>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>