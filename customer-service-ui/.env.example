# Base URL of the customer-service API, including the /api/customers path.
# Read at BUILD time by Vite (import.meta.env.VITE_CUSTOMER_API_URL).
#
#   local dev:  copy this file to .env.local (git-ignored) and adjust
#   Azure SWA:  set it in the Static Web App build configuration / workflow env
#
# It can also be overridden at runtime from the app's Settings page.
VITE_CUSTOMER_API_URL=http://localhost:8081/api/customers
