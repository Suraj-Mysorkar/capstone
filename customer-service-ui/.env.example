# Backend service base URLs. Read at BUILD time by Vite (import.meta.env.*).
# Each can also be overridden at runtime from the app's Settings page.
#
#   local dev:  copy this file to .env.local (git-ignored) and adjust
#   Azure SWA:  set them in the Static Web App build configuration / workflow env

# customer-service — registration & onboarding status. Include the /api/customers path.
VITE_CUSTOMER_API_URL=http://localhost:8081/api/customers

# loan-service — schemes, EMI, apply, applications, customer sync. Include /api/v1/loans.
# Defaults to a LOCAL loan-service: registration upserts the shared Customers table
# via POST /api/v1/loans/customers, which the deployed team6 build does not have yet.
# The local instance writes to the same Azure SQL DB the deployed service reads.
VITE_LOAN_API_URL=http://localhost:8080/api/v1/loans

# document-service — uploads & document status. Include the /api/v1/documents path.
VITE_DOC_API_URL=https://team6-document-service.azurewebsites.net/api/v1/documents
